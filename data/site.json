  "about": {
    "_note": "The about section under the tab bar: Shawn's portrait, the greeting “Hello, I’m Shawn!”, then the tab's words. Each entry in `messages` is a short paragraph; [words](address) makes a link. Written from Shawn's answers (2026-11-12/13). `image`: the one photo of Shawn, used on every tab.",
    "image": "../../public/photos/about/portrait.webp",
    "weddings": {
      "messages": [
        "I’ve loved photography for over 15 years, and shot weddings for the last three, including as part of the senior team at [iki](https://www.helloikicompany.com/).",
        "When I’m not behind a camera, I’m a [designer](https://shawn-sim-designs.vercel.app/). And I’m planning my own wedding too, so I know how much there is to think about.",
        "On the day I’m the one in sneakers, blending in and documenting moments, not poses. You’re not just hiring a vendor; you’re gaining a friend.",
        "If that speaks to you, [tell me about your day](#/enquire). We can meet for a coffee or a call first, no strings attached, and see if we’re a good fit."
      ]
    },
    "family": {
      "messages": [
        "Photography has been my hobby for over 15 years, and my work for three.",
        "With families I keep it simple: a few easy directions, then I step back. I look for soft greens, golden light and room to breathe.",
        "Mostly, I want you to look like yourselves."
      ]
    },
    "events": {
      "messages": [
        "By day I’m an event executive at Experience Matters, on the digital, interactive side of live events.",
        "So I know how a run sheet works, and which moments matter to the organiser. I’ll be where I need to be, and out of the way when I’m not."
      ]
    },
    "others": {
      "messages": [
        "More than 30 shoots in, I still like the ideas that don’t fit a box.",
        "Tell me what you have in mind, and we’ll work it out together."
      ]
    },
    "rates": {
      "messages": [
        "Plain prices, in Singapore dollars.",
        "Half on confirmation, half a week after the shoot."
      ]
    },
    "faq": {
      "messages": [
        "The things people usually ask me.",
        "If yours isn’t here, just ask."
      ]
    }
  },
  "closing": {
    "_note": "The dark card at the foot of every page except the form. `heading` and `default` everywhere; a page's entry replaces the line, and an object ({heading, text}) replaces both.",
    "heading": "Have a date? Tell me where and when.",
    "default": "Tell me the date, the place and what you have in mind. I’ll come back with how I’d photograph it.",
    "weddings": "Tell me the date, the venue and a little about the two of you. We meet before you book, so you know who’ll be following you around.",
    "family": "Tell me who’s coming and where you’d like to be. I’ll suggest a time with good light.",
    "events": "Send me the run sheet, or just the date and the venue, and I’ll come back with a quote that fits.",
    "others": "Tell me the idea, however rough. I’ll come back with how I’d shoot it and what it would cost.",
    "rates": {
      "heading": "No package that fits your plans? I’m flexible, and happy to tailor one to your occasion.",
      "text": "Longer day, two venues, a smaller budget? Tell me what you need and I’ll quote to fit."
    },
    "faq": "Still have a question, or a day that doesn’t fit these packages? Ask me directly.",
    "album": "Like what you see here? Tell me about your day and I’ll tell you how I’d photograph it."
  },
  "reviews": {
    "_note": "Kind words from clients, shown on the Weddings and Rates tabs. `quote` is the short pull-out, `full` the whole review as written (the client's words, kept as they are). `who` names them; `image` is a small photo from their shoot (null shows a print until one is added).",
    "items": [
      {
        "quote": "We found Shawn at the last minute after our original photographer had to cancel about a week before the wedding. Shawn agreed to take us on immediately.",
        "full": "We found Shawn at the last minute after our original photographer had to cancel about a week before the wedding. We were quite stressed, but Shawn agreed to take us on immediately and even arranged a Zoom call a few days before the wedding to get to know us and understand our preferences. That alone already gave us a lot of reassurance.\n\nOn the actual day, Shawn was very professional and patient. He gave clear, easy directions when it came to posing, which helped a lot since we don’t have as much experience posing in front of a camera. At the same time, he was able to capture many natural and candid shots of us throughout the evening. The whole photo-taking process went very smoothly under his direction.\n\nWhen the photos were released, they were beautifully presented on Pic-Time. Shawn also went the extra mile to help us edit and touch up a few photos upon request, which we really appreciate. Overall, we are very grateful to have had Shawn as our wedding photographer, and would definitely recommend him as someone reliable and easy to work with.",
        "who": "Ben & Gillian",
        "context": null,
        "image": null
      },
      {
        "quote": "Very professional and friendly! He gave me great direction and pointers for posing as it was my first time ever doing a shoot!",
        "full": null,
        "who": "Timothy & Grace",
        "context": null,
        "image": null
      }
    ]
